# /etc/buoy-heartbeat/heartbeat.env
# Mode 0640 root:root. The token file pointed at by OCTO_TOKEN_FILE
# must be mode 0600 root:root — buoy-heartbeat reads it once at boot.
#
# Filled in by scripts/install-buoy-heartbeat.sh during install.

OCTO_URL=http://<octo-tailnet-ip>:8771
OCTO_SLUG=__SET_BY_INSTALLER__
OCTO_TOKEN_FILE=/etc/buoy-heartbeat/token

# Optional — comma-separated systemd units to probe. Leave unset to
# use the default Athena-Buoy set:
#   tailscaled, wazuh-agent, opencanary, suricata,
#   buoy-forwarder, octo-forwarder, pihole-FTL, nextdns
#
# Override if a particular buoy doesn't run one of these (e.g. a buoy
# without pihole would just see 'missing' for pihole-FTL, which is
# fine; the override is only for noise reduction).
# Default: tailscaled,wazuh-agent,opencanary,suricata,buoy-forwarder,pihole-FTL,nextdns
# A listed unit that is DISABLED on purpose (systemctl disable / mask) shows
# as retired on the console, not degraded; an enabled unit that is not
# running is degraded.
#SERVICES=tailscaled,wazuh-agent,opencanary

# Optional — file that buoy-forwarder writes its last-success ISO
# timestamp into. If set + readable, contents are forwarded as
# last_event_at on every heartbeat.
#LAST_EVENT_FILE=/var/lib/buoy-forwarder/last-success

INTERVAL_SEC=60
STATE_DIR=/var/lib/buoy-heartbeat
HTTP_TIMEOUT_SEC=15
QUEUE_MAX=60

# Optional — buoy's geographic coordinates for the Fleet map view.
# Set once at install time so the buoy renders at its actual site on
# the Athena Console map. Decimal degrees; -90..90 lat, -180..180 lng.
# Operators using the Athena Console without the map view can omit
# these — heartbeat works fine without them; the buoy just doesn't
# render on the map.
#LAT=39.099724
#LNG=-94.578331

# Optional — wall-clock timeout per buoy command handler invocation
# (slice 11: ping / refresh / tail-log / restart-service). Default 60s
# is long enough for a systemd restart of any monitored unit; bump
# only if you have a known slow-starter unit (e.g., wazuh-agent on
# first start after migration).
#COMMAND_TIMEOUT_SEC=60

LOG_LEVEL=INFO
