{
  "name": "@athena/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Athena Console v3 — Vite + React + TS frontend (framework-aligned).",
  "license": "Apache-2.0",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b tsconfig.app.json --noEmit",
    "typecheck:tests": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "maplibre-gl": "^6.14.0",
    "pmtiles": "^4.4.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-grid-layout": "^1.5.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.19.17",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/react-grid-layout": "^1.3.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
